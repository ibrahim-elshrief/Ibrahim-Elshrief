rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Content & Site Management
    match /siteSettings/{docId} {
      allow read, write: if true;
    }

    match /homeSections/{sectionId} {
      allow read, write: if true;
    }

    match /portfolio/{projectId} {
      allow read, write: if true;
    }

    match /articles/{articleId} {
      allow read, write: if true;
    }

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /media/{mediaId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Orders, Inquiries & Inventory
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /inventoryTransactions/{txId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /subscribers/{subscriberId} {
      allow read, write: if true;
    }

    match /emailCampaigns/{campaignId} {
      allow read, write: if true;
    }

    match /mail/{mailId} {
      allow read, write: if true;
    }

    // User Accounts & System Configurations
    match /users/{userId} {
      allow read, write: if true;
    }

    match /systemConfig/{docId} {
      allow read, write: if true;
    }

    // Global Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}



